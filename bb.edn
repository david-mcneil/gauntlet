{:paths ["bb" "src"]
 :deps  {borkdude/rewrite-edn {:mvn/version "0.4.9"}}
 :pods  {org.babashka/go-sqlite3 {:version "0.3.13"}}
 :tasks
 {:requires    ([tools.setup :as setup])
  list        {:doc  "List work items"
               :requires ([tools.queue :as queue])
               :task (queue/list-items *command-line-args*)}
  show        {:doc  "Show an item with its runs, verdicts and findings: bb show <id>"
               :requires ([tools.queue :as queue])
               :task (queue/show *command-line-args*)}
  trace       {:doc  "Show the path an item took through the agents: bb trace <id>"
               :requires ([tools.queue :as queue])
               :task (queue/trace *command-line-args*)}
  add         {:doc  "Queue a work item: bb add <title> <spec-file>  (- reads stdin)"
               :requires ([tools.queue :as queue])
               :task (queue/add *command-line-args*)}
  requeue     {:doc  "Return a needs_human item to the step it failed in: bb requeue <id>"
               :requires ([tools.queue :as queue])
               :task (queue/requeue *command-line-args*)}
  spent       {:doc  "Show today's spend against the daily budget"
               :requires ([tools.queue :as queue])
               :task (queue/spent *command-line-args*)}
  doctor      {:doc  "Check the setup and say what to do next"
               :task (exec 'tools.doctor/-main)}
  init        {:doc  "Create gauntlet.edn for a project: bb init <project-repo>"
               :task (setup/init *command-line-args*)}
  runtime     {:doc  "Switch the agent runtime: bb runtime fake|docker"
               :task (setup/set-runtime *command-line-args*)}
  auth        {:doc  "Choose how agents authenticate: bb auth subscription|api-key"
               :task (setup/set-auth *command-line-args*)}
  login       {:doc  "Get and store the credential agents use (subscription token or API key)"
               :task (setup/login *command-line-args*)}
  check-auth  {:doc  "Check the stored credential with a one-line request"
               :task (setup/check-auth *command-line-args*)}
  bootstrap   {:doc  "Queue a work item that sets up the project for the reviewer inputs"
               :task (setup/bootstrap *command-line-args*)}
  build-image {:doc  "Build the Docker image that agents run in"
               :task (setup/build-image)}}}
